{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "IRS Form 1040 (2024) \u2014 Generalized Extraction Schema (page-agnostic)",
  "type": "object",
  "additionalProperties": false,
  "description": "Extract exactly what is PRINTED on the 2024 Form 1040. Do not compute, infer, normalize, or carry values across schedules. If a value/box is blank or unreadable, return null (not 0/false/empty string). Keep numeric sign semantics:  '(1,234)' \u2192 -1234; '\u2014', 'n/a', blanks \u2192 null. This schema avoids page assumptions; match by printed labels/line numbers.",
  "x-guidance": {
    "page_agnostic": true,
    "anchor_strategy": "Prefer the nearest printed label text and official line number (e.g., 'Line 1a'). Ignore PDF page numbers or layout positions.",
    "tri_state_checkboxes": "For checkboxes, use true (clearly checked), false (clearly unchecked), null (not present or unreadable).",
    "numbers": "Strip '$' and commas; keep negatives with a leading minus when parentheses are printed.",
    "masked_identifiers": "Allow masked SSNs like 'XXX-XX-1234' or '***-**-1234' if that is exactly what the form shows."
  },
  "properties": {
    "form_name": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "Form 1040",
        null
      ],
      "description": "Form title anchor: capture the literal text 'Form 1040' from the form header area wherever it appears. Null if absent/cropped."
    },
    "tax_year": {
      "type": [
        "integer",
        "null"
      ],
      "enum": [
        2024,
        null
      ],
      "description": "Printed tax year associated with the title 'U.S. Individual Income Tax Return'. If multiple years appear (e.g., watermark), choose the boldface/primary title year."
    },
    "filing_status": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "Single",
        "Married filing jointly",
        "Married filing separately",
        "Head of household",
        "Qualifying surviving spouse",
        null
      ],
      "description": "Checkbox group labeled 'Filing Status'. Return the label of the CHECKED box. If more than one appears checked or mark is ambiguous, return null."
    },
    "presidential_election_campaign": {
      "type": "object",
      "additionalProperties": false,
      "description": "Checkboxes labeled '$3 to this fund' for 'you' and (if applicable) 'spouse'. Tri-state handling for scan ambiguity.",
      "properties": {
        "you": {
          "type": [
            "boolean",
            "null"
          ],
          "description": "Your '$3 to this fund' checkbox."
        },
        "spouse": {
          "type": [
            "boolean",
            "null"
          ],
          "description": "Spouse '$3 to this fund' checkbox, only if printed."
        }
      }
    },
    "taxpayer": {
      "type": "object",
      "additionalProperties": false,
      "description": "Primary filer identity block. Use exactly the text printed in the labeled name/SSN fields; do not infer from elsewhere.",
      "properties": {
        "first_name": {
          "type": [
            "string",
            "null"
          ],
          "description": "Capture as printed; include accents/hyphens."
        },
        "middle_initial": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 1,
          "description": "Single character if printed; null if blank."
        },
        "last_name": {
          "type": [
            "string",
            "null"
          ],
          "description": "Capture as printed."
        },
        "ssn": {
          "$ref": "#/$defs/ssn_nullable"
        },
        "born_before_1960": {
          "type": [
            "boolean",
            "null"
          ],
          "description": "Checkbox labeled 'Were born before January 2, 1960'. Tri-state."
        },
        "blind": {
          "type": [
            "boolean",
            "null"
          ],
          "description": "Checkbox labeled 'Are blind'. Tri-state."
        },
        "can_be_claimed_as_dependent": {
          "type": [
            "boolean",
            "null"
          ],
          "description": "Standard deduction sublabel 'Someone can claim: You'. Tri-state."
        }
      }
    },
    "spouse": {
      "type": "object",
      "additionalProperties": false,
      "description": "Spouse identity block (when present) within the same name/SSN area as the primary filer.",
      "properties": {
        "first_name": {
          "type": [
            "string",
            "null"
          ],
          "description": "As printed."
        },
        "middle_initial": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 1,
          "description": "As printed; nullable."
        },
        "last_name": {
          "type": [
            "string",
            "null"
          ],
          "description": "As printed."
        },
        "ssn": {
          "$ref": "#/$defs/ssn_nullable"
        },
        "born_before_1960": {
          "type": [
            "boolean",
            "null"
          ],
          "description": "Checkbox 'Were born before January 2, 1960'. Tri-state."
        },
        "blind": {
          "type": [
            "boolean",
            "null"
          ],
          "description": "Checkbox 'Are blind'. Tri-state."
        },
        "can_be_claimed_as_dependent": {
          "type": [
            "boolean",
            "null"
          ],
          "description": "Standard deduction sublabel 'Spouse'. Tri-state."
        },
        "spouse_itemizes_or_dual_status": {
          "type": [
            "boolean",
            "null"
          ],
          "description": "Checkbox labeled 'Spouse itemizes on a separate return or you were a dual-status alien'. Tri-state."
        }
      }
    },
    "address": {
      "type": "object",
      "additionalProperties": false,
      "description": "Mailing address block. Do not normalize; copy as printed in the labeled address lines.",
      "properties": {
        "street": {
          "type": [
            "string",
            "null"
          ],
          "description": "Labeled 'Home address (number and street)'; include P.O. Box if printed there."
        },
        "apt_no": {
          "type": [
            "string",
            "null"
          ],
          "description": "Labeled 'Apt. no.' or similar; null if not separated."
        },
        "city": {
          "type": [
            "string",
            "null"
          ],
          "description": "City/town as printed."
        },
        "state": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 2,
          "maxLength": 2,
          "description": "2-letter USPS code as printed. Null for foreign addresses."
        },
        "zip": {
          "$ref": "#/$defs/zip_nullable"
        },
        "foreign": {
          "type": "object",
          "additionalProperties": false,
          "description": "Populate only if the foreign-address layout is used.",
          "properties": {
            "country": {
              "type": [
                "string",
                "null"
              ],
              "description": "Country name as printed (do not ISO-code)."
            },
            "province_state_county": {
              "type": [
                "string",
                "null"
              ],
              "description": "Region/Province/County as printed."
            },
            "postal_code": {
              "type": [
                "string",
                "null"
              ],
              "description": "Foreign postal code as printed."
            }
          }
        }
      }
    },
    "digital_assets_question": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "Yes",
        "No",
        null
      ],
      "description": "Yes/No question containing the phrase 'digital assets'. Return the selected label; null if ambiguous or not present."
    },
    "dependents": {
      "type": "array",
      "description": "Dependents grid labeled 'Dependents'. Preserve row order as printed; omit entirely blank rows.",
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "first_name": {
            "type": [
              "string",
              "null"
            ]
          },
          "last_name": {
            "type": [
              "string",
              "null"
            ]
          },
          "ssn": {
            "$ref": "#/$defs/ssn_nullable",
            "description": "SSN/ITIN/ATIN as printed; allow masked formats like 'XXX-XX-1234'."
          },
          "relationship": {
            "type": [
              "string",
              "null"
            ],
            "description": "Relationship text as printed (e.g., 'Son')."
          },
          "eligible_child_tax_credit": {
            "type": [
              "boolean",
              "null"
            ],
            "description": "Checkbox column 'child tax credit'. Tri-state."
          },
          "eligible_other_dependents_credit": {
            "type": [
              "boolean",
              "null"
            ],
            "description": "Checkbox column 'credit for other dependents'. Tri-state."
          }
        }
      }
    },
    "income_and_adjustments": {
      "type": "object",
      "additionalProperties": false,
      "description": "Lines 1\u201315 (Income and Adjustments). NUMBERS ONLY. Strip '$' and commas. Parentheses mean negative. Blank/\u2014 \u2192 null. Do not recompute totals; capture printed values only.",
      "properties": {
        "line_1a_wages": {
          "$ref": "#/$defs/money_nullable",
          "description": "Label anchor: '1a Wages, salaries, tips'."
        },
        "line_1b_household_employee_wages": {
          "$ref": "#/$defs/money_nullable"
        },
        "line_1c_tip_income_not_reported": {
          "$ref": "#/$defs/money_nullable"
        },
        "line_1d_medicaid_waiver_payments": {
          "$ref": "#/$defs/money_nullable"
        },
        "line_1e_adoption_benefits": {
          "$ref": "#/$defs/money_nullable"
        },
        "line_1f_wages_from_form_8919": {
          "$ref": "#/$defs/money_nullable"
        },
        "line_1g_other_earned_income": {
          "$ref": "#/$defs/money_nullable"
        },
        "line_1h_nontaxable_combat_pay_election": {
          "$ref": "#/$defs/money_nullable",
          "description": "Only capture if an amount is printed with the label; a standalone checkbox without amount \u2192 null."
        },
        "line_1z_total_wages_and_other": {
          "$ref": "#/$defs/money_nullable",
          "description": "Total for line 1; do NOT recompute."
        },
        "line_2a_tax_exempt_interest": {
          "$ref": "#/$defs/money_nullable"
        },
        "line_2b_taxable_interest": {
          "$ref": "#/$defs/money_nullable"
        },
        "line_3a_qualified_dividends": {
          "$ref": "#/$defs/money_nullable"
        },
        "line_3b_ordinary_dividends": {
          "$ref": "#/$defs/money_nullable"
        },
        "line_4a_ira_distributions_total": {
          "$ref": "#/$defs/money_nullable"
        },
        "line_4b_ira_distributions_taxable": {
          "$ref": "#/$defs/money_nullable"
        },
        "line_5a_pensions_annuities_total": {
          "$ref": "#/$defs/money_nullable"
        },
        "line_5b_pensions_annuities_taxable": {
          "$ref": "#/$defs/money_nullable"
        },
        "line_6a_social_security_benefits_total": {
          "$ref": "#/$defs/money_nullable"
        },
        "line_6b_social_security_benefits_taxable": {
          "$ref": "#/$defs/money_nullable"
        },
        "line_7_capital_gain_or_loss": {
          "$ref": "#/$defs/money_nullable",
          "description": "If printed as 'See Schedule D' with no numeric value on 1040, return null."
        },
        "line_8_other_income_sched1_line10": {
          "$ref": "#/$defs/money_nullable"
        },
        "line_9_total_income": {
          "$ref": "#/$defs/money_nullable"
        },
        "line_10_adjustments_sched1_line26": {
          "$ref": "#/$defs/money_nullable"
        },
        "line_11_adjusted_gross_income": {
          "$ref": "#/$defs/money_nullable"
        },
        "line_12_standard_or_itemized_deductions": {
          "$ref": "#/$defs/money_nullable"
        },
        "line_13_qbi_deduction_from_8995_or_8995A": {
          "$ref": "#/$defs/money_nullable"
        },
        "line_14_add_lines_12_and_13": {
          "$ref": "#/$defs/money_nullable"
        },
        "line_15_taxable_income": {
          "$ref": "#/$defs/money_nullable"
        }
      }
    },
    "tax_and_credits": {
      "type": "object",
      "additionalProperties": false,
      "description": "Lines 16\u201324 (Tax and Credits). Use printed amounts only; if the form references another schedule without a number on 1040, use null.",
      "properties": {
        "line_16_tax": {
          "$ref": "#/$defs/money_nullable"
        },
        "line_17_schedule2_line3": {
          "$ref": "#/$defs/money_nullable"
        },
        "line_18_add_lines_16_and_17": {
          "$ref": "#/$defs/money_nullable"
        },
        "line_19_child_tax_credit_or_other_dependents_sched8812": {
          "$ref": "#/$defs/money_nullable"
        },
        "line_20_amount_from_schedule3_line8": {
          "$ref": "#/$defs/money_nullable"
        },
        "line_21_add_lines_19_and_20": {
          "$ref": "#/$defs/money_nullable"
        },
        "line_22_subtract_line_21_from_line_18": {
          "$ref": "#/$defs/money_nullable"
        },
        "line_23_other_taxes_schedule2_line21": {
          "$ref": "#/$defs/money_nullable"
        },
        "line_24_total_tax": {
          "$ref": "#/$defs/money_nullable"
        }
      }
    },
    "payments_and_refundable_credits": {
      "type": "object",
      "additionalProperties": false,
      "description": "Lines 25\u201333 (Payments and refundable credits).",
      "properties": {
        "line_25a_fed_income_tax_withheld_w2": {
          "$ref": "#/$defs/money_nullable"
        },
        "line_25b_fed_income_tax_withheld_1099": {
          "$ref": "#/$defs/money_nullable"
        },
        "line_25c_fed_income_tax_withheld_other": {
          "$ref": "#/$defs/money_nullable"
        },
        "line_25d_total_fed_income_tax_withheld": {
          "$ref": "#/$defs/money_nullable"
        },
        "line_26_2024_estimated_payments_and_2023_applied": {
          "$ref": "#/$defs/money_nullable"
        },
        "line_27_earned_income_credit_eic": {
          "$ref": "#/$defs/money_nullable"
        },
        "line_28_additional_child_tax_credit_sched8812": {
          "$ref": "#/$defs/money_nullable"
        },
        "line_29_american_opportunity_credit_form8863_line8": {
          "$ref": "#/$defs/money_nullable"
        },
        "line_31_amount_from_schedule3_line15": {
          "$ref": "#/$defs/money_nullable"
        },
        "line_32_total_other_payments_and_refundable_credits": {
          "$ref": "#/$defs/money_nullable"
        },
        "line_33_total_payments": {
          "$ref": "#/$defs/money_nullable"
        }
      }
    },
    "refund": {
      "type": "object",
      "additionalProperties": false,
      "description": "Lines 34\u201336 (Refund). Only populate direct deposit details if routing/account numbers are printed.",
      "properties": {
        "line_34_overpaid": {
          "$ref": "#/$defs/money_nullable"
        },
        "line_35a_amount_to_be_refunded": {
          "$ref": "#/$defs/money_nullable"
        },
        "line_35a_form_8888_attached": {
          "type": [
            "boolean",
            "null"
          ],
          "description": "Notation that Form 8888 is attached. Tri-state."
        },
        "direct_deposit": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "routing_number": {
              "$ref": "#/$defs/routing_number_nullable"
            },
            "account_number": {
              "$ref": "#/$defs/account_number_nullable"
            },
            "account_type": {
              "type": [
                "string",
                "null"
              ],
              "enum": [
                "Checking",
                "Savings",
                null
              ],
              "description": "Return the printed selection; else null."
            }
          }
        },
        "line_36_amount_applied_to_2025_estimated_tax": {
          "$ref": "#/$defs/money_nullable"
        }
      }
    },
    "amount_you_owe": {
      "type": "object",
      "additionalProperties": false,
      "description": "Lines 37\u201338 (Amount You Owe).",
      "properties": {
        "line_37_amount_you_owe": {
          "$ref": "#/$defs/money_nullable"
        },
        "line_38_estimated_tax_penalty": {
          "$ref": "#/$defs/money_nullable"
        }
      }
    },
    "signature_and_other_info": {
      "type": "object",
      "additionalProperties": false,
      "description": "Blocks titled 'Sign Here', 'Third Party Designee', and 'Paid Preparer Use Only'. Do not synthesize contact info from elsewhere.",
      "properties": {
        "your_occupation": {
          "type": [
            "string",
            "null"
          ]
        },
        "spouse_occupation": {
          "type": [
            "string",
            "null"
          ]
        },
        "phone": {
          "type": [
            "string",
            "null"
          ],
          "description": "Copy as printed, including punctuation/formatting. Do not normalize to E.164."
        },
        "email": {
          "type": [
            "string",
            "null"
          ],
          "description": "As printed. Do not repair/guess."
        },
        "identity_protection_pin_primary": {
          "$ref": "#/$defs/ip_pin_nullable"
        },
        "identity_protection_pin_spouse": {
          "$ref": "#/$defs/ip_pin_nullable"
        },
        "third_party_designee": {
          "type": [
            "boolean",
            "null"
          ],
          "description": "Authorization block: true if a designee is clearly indicated; false if clearly 'No'; null if absent/unclear."
        },
        "third_party_designee_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "third_party_phone": {
          "type": [
            "string",
            "null"
          ]
        },
        "third_party_pin": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^\\d{5}$",
          "description": "5 digits if printed; null if blank."
        },
        "paid_preparer_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "paid_preparer_ptin": {
          "type": [
            "string",
            "null"
          ]
        },
        "paid_preparer_self_employed": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "paid_preparer_firm_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "paid_preparer_firm_ein": {
          "type": [
            "string",
            "null"
          ]
        },
        "paid_preparer_firm_address": {
          "type": [
            "string",
            "null"
          ]
        },
        "paid_preparer_phone": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  },
  "required": [
    "form_name",
    "tax_year"
  ],
  "$defs": {
    "money_nullable": {
      "type": [
        "number",
        "null"
      ],
      "description": "USD numeric ONLY (no '$' or commas). Parentheses \u2192 negative. Examples: '$1,234' \u2192 1234; '(2,050)' \u2192 -2050; '\u2014' or blank \u2192 null."
    },
    "ssn_nullable": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^(\\d{3}-\\d{2}-\\d{4}|XXX-XX-\\d{4}|\\*\\*\\*-\\*\\*-\\d{4})$",
      "description": "SSN/ITIN/ATIN as printed. Allow masked last-4 formats (XXX-XX-1234, ***-**-1234). Null if missing."
    },
    "zip_nullable": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^\\d{5}(-\\d{4})?$",
      "description": "ZIP or ZIP+4 as printed; null for foreign addresses."
    },
    "ip_pin_nullable": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^\\d{6}$",
      "description": "6-digit IP PIN if printed; null if blank."
    },
    "routing_number_nullable": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^\\d{9}$",
      "description": "9 digits; ignore spaces/dashes if present in print (return digits only). Null if not present."
    },
    "account_number_nullable": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 4,
      "maxLength": 17,
      "description": "Account number exactly as printed (no padding). Null if not present."
    }
  }
}